@MediaDock.Api_HostAddress = http://localhost:5280
@titleId = 1
@sourceId = 1

GET {{MediaDock.Api_HostAddress}}/health/live
Accept: application/json

###

GET {{MediaDock.Api_HostAddress}}/health/ready
Accept: application/json

###

GET {{MediaDock.Api_HostAddress}}/api/catalog?page=1&pageSize=25&search=matrix&mediaType=movie
Accept: application/json

###

GET {{MediaDock.Api_HostAddress}}/api/titles/{{titleId}}
Accept: application/json

###

GET {{MediaDock.Api_HostAddress}}/api/titles/{{titleId}}/occurrences?page=1&pageSize=25
Accept: application/json

###

GET {{MediaDock.Api_HostAddress}}/api/sources
Accept: application/json

###

GET {{MediaDock.Api_HostAddress}}/api/sources
Accept: application/json

###

# Source and settings writes are unauthenticated and assume trusted LAN access only.
POST {{MediaDock.Api_HostAddress}}/api/sources/movie/urls
Content-Type: application/json

{
	"url": "https://feed.rutracker.cc/movies.atom"
}

###

PUT {{MediaDock.Api_HostAddress}}/api/sources/movie/urls/{{sourceId}}
Content-Type: application/json

{
	"url": "https://feed.rutracker.cc/movies.atom"
}

###

DELETE {{MediaDock.Api_HostAddress}}/api/sources/movie/urls/{{sourceId}}

###

GET {{MediaDock.Api_HostAddress}}/api/settings
Accept: application/json

###

PUT {{MediaDock.Api_HostAddress}}/api/settings
Content-Type: application/json

{
	"excludedGenres": [],
	"excludedCountries": [],
	"minMovieRating": 0,
	"minSeriesRating": 0,
	"minImdbVotes": 0
}

###

GET {{MediaDock.Api_HostAddress}}/api/settings/providers/omdb
Accept: application/json

###

PUT {{MediaDock.Api_HostAddress}}/api/settings/providers/omdb
Content-Type: application/json

{
	"omdbApiKey": "replace-with-local-key",
	"clearOmdbApiKey": false,
	"omdbDailyRequestLimit": 100,
	"oscarEnrichmentMaxFilmsPerRun": 0,
	"oscarEnrichmentMaxRequestsPerDay": 0
}

###

GET {{MediaDock.Api_HostAddress}}/api/parse-logs?page=1&pageSize=25
Accept: application/json

###

GET {{MediaDock.Api_HostAddress}}/api/scan-runs?page=1&pageSize=25
Accept: application/json
