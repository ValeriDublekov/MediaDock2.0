[Unit]
Description=MediaDock 2.0 deployment control socket
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/mediadock-next-deploy-control
User=root
Group=root
StateDirectory=mediadock-deploy-control
StateDirectoryMode=0755
Restart=on-failure
RestartSec=2s
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/mediadock-deploy-control /var/lib/mediadock-deploy

[Install]
WantedBy=multi-user.target